ISLAND_IS_TOKEN_URL=
# LOCAL DOCKER ONLY -- never set this in 1Password or in ECS.
#
# Running the production build locally in Docker sets NODE_ENV=production, which
# makes NextAuth issue secure cookies, but there is no HTTPS in front of the
# local container so the browser drops them. Setting this to "false" forces
# plain-http cookies for that case only.
#
# libs/shared/auth/src/lib/middleware-helpers.ts reads it as
# `!== 'false'`, so it is secure by default and this is a deliberate opt-out.
# Set in the three web docker-compose.yml files and nowhere else.
# @type=boolean @public
NEXTAUTH_COOKIE_SECURE=
NEXTAUTH_SECRET=
# @type=url @public
NEXTAUTH_URL=

