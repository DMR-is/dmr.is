# Configuration specific to legal-gazette-web.
# Authoring rules and the shared items this imports: see the root schema.
#
# @defaultRequired=infer
# @currentEnv=$DMR_RUNTIME
# @import(../../, pick=[
#   ANALYZE,
#   API_MOCKS,
#   BASE_URL,
#   DMR_ADMIN_API_BASE_PATH,
#   IDENTITY_SERVER_*,
#   ISLAND_IS_DMR_WEB_CLIENT_ID,
#   ISLAND_IS_DMR_WEB_CLIENT_SECRET,
#   LOG_LEVEL,
#   NEXTAUTH_*,
#   NODE_ENV,
#   VERCEL_URL
# ])
# ---

# Declared per file because varlock resolves the currentEnv flag only against
# items in the same file. Rationale: DMR_RUNTIME in the root schema.
# @public @type=enum(local, deployed)
DMR_RUNTIME=deployed


# ---
# Required at container boot
# ---
#
# Every name below is set by this app's ECS task definition and by the local
# 1Password environment, the same names in both -- one shape to get right, not
# two.
#
# The image is built with an empty environment and run with these present, so
# this validates at boot, not at build. Nothing here may be read at build time.

# @required=true
BASE_URL=
# @required=true
NEXTAUTH_URL=
# @required=true
NEXTAUTH_SECRET=
# @required=true
IDENTITY_SERVER_DOMAIN=
# @required=true
IDENTITY_SERVER_LOGOUT_URL=
# @required=true
DMR_ADMIN_API_BASE_PATH=
# @required=true @public
ISLAND_IS_DMR_WEB_CLIENT_ID=
# @required=true
ISLAND_IS_DMR_WEB_CLIENT_SECRET=
