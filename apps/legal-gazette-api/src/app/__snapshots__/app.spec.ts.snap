        ],
        "type": "object",
      },
      "ObjectIssuer": {
        "properties": {
          "externalId": {
            "description": "External id if external service sent the advert",
            "type": "string",
          },
          "name": {
            "description": "Name of the party responsible for the advert",
            "example": "Ríkisskattstjóri, hlutafélagaskrá",
            "type": "string",
          },
          "nationalId": {
            "description": "The national id of who is responsible for the advert",
            "example": "1234567890",
            "type": "string",
          },
          "signature": {
            "$ref": "#/components/schemas/ResponsiblePartySignature",
          },
        },
        "required": [
          "name",
          "nationalId",
          "signature",
        ],
        "type": "object",
      },
      "PartyEntityDto": {
        "properties": {
          "address": {
            "description": "Address of the party",
            "example": "Laugavegur 1, 101 Reykjavik",
            "type": "string",
          },
          "jobTitle": {
            "description": "Job title of the party, always comes last if present",
            "example": "löggiltur endurskoðandi",
            "type": "string",
          },
          "name": {
            "description": "Name of the party",
            "example": "Jón Jónsson / Jón ehf.",
            "type": "string",
          },
          "nationalId": {
            "description": "National id of the party",
            "example": "1234567890",
            "type": "string",
          },
          "role": {
            "description": "Role of the party, always comes first if present",
            "example": "Stjórnarmaður, meðstjórnandi o.s.frv.",
            "type": "string",
          },
        },
        "required": [
          "name",
        ],
        "type": "object",
      },
      "RegisterCompanyFirmaskraDto": {
        "properties": {
          "additionalProperties": {
            "description": "Additional properties (Auka eigindi, birtast neðst í auglýsingu)",
            "items": {
              "$ref": "#/components/schemas/AdditionalPropertiesDto",
            },
            "type": "array",
          },
          "approvedDate": {
            "description": "Date when the company was accepted (Dagsetning samþykkta er)",
            "example": "2023-10-01T12:00:00Z (ISO 8601 format)",
            "format": "date-time",
            "type": "string",
          },
          "creators": {
            "description": "List of registered company creators (Stofnendur)",
            "items": {
              "$ref": "#/components/schemas/PartyEntityDto",
            },
            "type": "array",
          },
          "firmWriting": {
            "description": "Firmaritun",
            "example": "Allir félagsmenn saman",
            "type": "string",
          },
          "name": {
            "description": "Name of the registered company (Félagið heitir)",
            "example": "HXM ehf.",
            "type": "string",
          },
          "nationalId": {
            "description": "National id of the registered company (Kennitala fyrirtækis)",
            "example": "1234567890",
            "type": "string",
          },
          "procurationHolders": {
            "description": "The procuration holders of the company (Prókuruumboð)",
            "items": {
              "$ref": "#/components/schemas/PartyEntityDto",
            },
            "type": "array",
          },
          "purpose": {
            "description": "The purpose of the company (Tilgangur)",
            "type": "string",
          },
          "registeredAddress": {
            "description": "Address of the registered company (Skráð heimilisfang fyrirtækis)",
            "example": "Laugavegur 1, 101 Reykjavik",
            "type": "string",
          },
          "responsibleParty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ObjectIssuer",
              },
            ],
            "description": "The party responsible for the company",
          },
          "taxMembership": {
            "description": "Tax membership status (Skattaðlid)",
            "example": "félagið er sjálfstæður skattaðili",
            "type": "string",
          },
        },
        "required": [
          "responsibleParty",
          "name",
          "nationalId",
          "registeredAddress",
          "creators",
          "approvedDate",
          "purpose",
          "taxMembership",
          "firmWriting",
        ],
        "type": "object",
      },
      "RegisterCompanyHlutafelagDto": {
        "properties": {
          "approvedDate": {
            "description": "Date when the company was accepted (Dagsetning samþykkta er)",
            "example": "2023-10-01T12:00:00Z (ISO 8601 format)",
            "format": "date-time",
            "type": "string",
          },
          "auditors": {
            "description": "The auditors of the company (Skoðunarmaður/endurskoðandi)",
            "items": {
              "$ref": "#/components/schemas/PartyEntityDto",
            },
            "type": "array",
          },
          "benefits": {
            "description": "Are there special benefits (Hömlur á meðferð hlutabréfa)",
            "example": false,
            "type": "boolean",
          },
          "board": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CompanyBoardDto",
              },
            ],
            "description": "The board of the company (Stjórn)",
          },
          "capital": {
            "description": "The capital of the company in ISK (Hlutafé kr.)",
            "example": 1000000,
            "type": "number",
          },
          "creators": {
            "description": "List of registered company creators (Stofnendur)",
            "items": {
              "$ref": "#/components/schemas/PartyEntityDto",
            },
            "type": "array",
          },
          "liquidationObligation": {
            "description": "Is there an obligation for liquidation (Lausnarskylda á hlutabréfum)",
            "example": false,
            "type": "boolean",
          },
          "name": {
            "description": "Name of the registered company (Félagið heitir)",
            "example": "HXM ehf.",
            "type": "string",
          },
          "nationalId": {
            "description": "National id of the registered company (Kennitala fyrirtækis)",
            "example": "1234567890",
            "type": "string",
          },
          "procurationHolders": {
            "description": "The procuration holders of the company (Prókuruumboð)",
            "items": {
              "$ref": "#/components/schemas/PartyEntityDto",
            },
            "type": "array",
          },
          "purpose": {
            "description": "The purpose of the company (Tilgangur)",
            "type": "string",
          },
          "registeredAddress": {
            "description": "Address of the registered company (Skráð heimilisfang fyrirtækis)",
            "example": "Laugavegur 1, 101 Reykjavik",
            "type": "string",
          },
          "responsibleParty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ObjectIssuer",
              },
            ],
            "description": "The party responsible for the company",
          },
          "signature": {
            "example": "Ef einn í stjórn:  Stjórnarmaður, ef stjórn er fjölskipuð: Meirihluti stjórnar (Firmað ritar)",
            "type": "string",
          },
        },
        "required": [
          "responsibleParty",
          "name",
          "nationalId",
          "registeredAddress",
          "creators",
          "approvedDate",
          "board",
          "signature",
          "auditors",
          "capital",
          "purpose",
          "benefits",
          "liquidationObligation",
        ],
        "type": "object",
      },
      "ResponsiblePartySignature": {
        "properties": {
          "date": {
            "example": "2026-02-19T10:30:00.000Z",
            "format": "date-time",
            "nullable": true,
            "type": "string",
          },
          "location": {
            "nullable": true,
            "type": "string",
          },
          "name": {
            "nullable": true,
            "type": "string",
          },
          "onBehalfOf": {
            "nullable": true,
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http",
      },
    },
