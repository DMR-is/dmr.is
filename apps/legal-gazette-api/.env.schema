# Configuration specific to legal-gazette-api.
# Authoring rules and the shared items this imports: see the root schema.
#
# @defaultRequired=infer
# @currentEnv=$DMR_RUNTIME
# @import(../../, pick=[
#   ADVERTS_CDN_URL,
#   AWS_*,
#   CACHE_DEBUG,
#   DB_*,
#   ENABLE_REDIS,
#   HOSTNAME,
#   IDENTITY_SERVER_DOMAIN,
#   INIT_SCHEMA,
#   LOCAL_CHROMIUM_PATH,
#   LOG_LEVEL,
#   NATIONAL_REGISTRY_*,
#   NODE_ENV,
#   REDIS_*,
#   SEND_FROM_EMAIL_ADDRESS,
#   XROAD_DMR_CLIENT
# ])
# ---

# Declared per file because varlock resolves the currentEnv flag only against
# items in the same file. Rationale: DMR_RUNTIME in the root schema.
# @public @type=enum(local, deployed)
DMR_RUNTIME=deployed

# Deployment environment, dev or prod. Not the validation axis -- DMR_RUNTIME
# cannot tell the two deployments apart. Set by ECS when deployed, dev locally.
# @public @type=enum(dev, prod)
API_ENV=dev

# ---
# Misc
# ---

# @type=port @public
LEGAL_GAZETTE_API_PORT=
# @public @required=true
LEGAL_GAZETTE_BUCKET=
# @type=url @public @required=true
LEGAL_GAZETTE_CDN_URL=
# @type=port @public
LEGAL_GAZETTE_DB_PORT=
# @public @required=true
LEGAL_GAZETTE_MACHINE_CLIENT_SCOPES=
# @type=number @public
LG_SUBSCRIPTION_AMOUNT=
# @public
LG_SUBSCRIPTION_FEE_CODE=
# @public @required=true
LG_TBR_CHARGE_CATEGORY_COMPANY=
# @public @required=true
LG_TBR_CHARGE_CATEGORY_PERSON=
# @required=true
LG_TBR_CREDENTIALS=
# @type=number @public @required=true
LG_TBR_OFFICE_ID=
# @type=url @public @required=true
LG_TBR_PATH=
# @type=number @public
TBR_CHUNK_DELAY_MS=
# @type=number @public
TBR_CHUNK_SIZE=

# ---
# Required in every environment
# ---

# @public @required=true
DB_HOST=
# @public @required=true
DB_NAME=
# @required=true
DB_PASS=
# @public @required=true
DB_USER=

# Every name below is verified present in
# utgafa/_envcommon/legal_gazette_api.hcl -- the precondition for marking
# anything required, since a marker on a variable ECS does not set is an outage
# on the next deploy. It matters most for the DB group and LEGAL_GAZETTE_BUCKET:
# their readers default to a dev value, so a dropped ECS variable boots clean
# against the wrong place instead of crashing.
#
# Not marked, deliberately: REDIS_*, the one place the deployments really differ
# (ENABLE_REDIS is true in dev, false in prod, while
# REDIS_HOST/PORT/USER/PASSWORD are injected in both); and AWS_REGION /
# AWS_CREDENTIALS_SOURCE, which come from the task role or a laptop's AWS
# session, hence the varlock-run.sh scrub exemption.

# @type=port @public @required=true
DB_PORT=
# @public @required=true
IDENTITY_SERVER_DOMAIN=
# @public @required=true
SEND_FROM_EMAIL_ADDRESS=
# @public @required=true
XROAD_DMR_CLIENT=
# @type=url @public @required=true
NATIONAL_REGISTRY_API_LOGIN_PATH=
# @type=url @public @required=true
NATIONAL_REGISTRY_API_LOOKUP_PATH=
# @public @required=true
NATIONAL_REGISTRY_CLIENT_USER=
# @required=true
NATIONAL_REGISTRY_CLIENT_PASSWORD=
