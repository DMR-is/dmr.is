# Configuration specific to legal-gazette-api.
#
# Shared items (database, redis, AWS, identity server, ...) are inherited from
# the root schema — but only the ones this app actually reads, so validation
# here means "this app can boot", not "the monorepo is fully configured".
# This file declares what is unique to the app, plus the required-overrides for
# what it genuinely cannot start without.
#
# NOTE: decorator names must never appear with a leading at-sign in prose here.
# Varlock parses every at-token in a comment block as a decorator, so a sentence
# mentioning one is read as a redeclaration with the sentence as its value.
#
# Root decorators are per-file and do NOT propagate through an import, so the
# defaultRequired and currentEnv settings are repeated below. Without the first,
# every item defaults to required; without the second, every forEnv() call fails
# with "current environment is not set".
#
# TypeScript type generation is intentionally NOT enabled yet. Nothing imports
# the generated ENV, the output is gitignored, and varlock emits its ts-nocheck
# pragma on the line above its eslint-disable, so the file fails this repo's
# ban-ts-comment rule and breaks nx lint. When types are wired up, add:
#   generateTsTypes(path=./env.ts, exposeEnv=local)   [with a leading at-sign]
# exposeEnv=local is required in a monorepo — without it every package augments
# the single global varlock/env module and the schemas merge.
#
# @defaultRequired=infer
# @currentEnv=$API_ENV
# @import(../../, pick=[
#   ADVERTS_CDN_URL,
#   AWS_*,
#   CACHE_DEBUG,
#   DB_*,
#   ENABLE_REDIS,
#   HOSTNAME,
#   IDENTITY_SERVER_DOMAIN,
#   INIT_SCHEMA,
#   LOCAL_CHROMIUM_PATH,
#   LOG_LEVEL,
#   NATIONAL_REGISTRY_*,
#   NODE_ENV,
#   REDIS_*,
#   SEND_FROM_EMAIL_ADDRESS,
#   XROAD_DMR_CLIENT
# ])
# ---

# Deployment environment. Declared here rather than imported: varlock requires
# the currentEnv flag to live in the same file as the decorator. Set by ECS when
# deployed, defaults to dev locally.
# @public @type=enum(dev, prod)
API_ENV=dev

# ---
# Misc
# ---

# @type=port @public
LEGAL_GAZETTE_API_PORT=
# @public
LEGAL_GAZETTE_BUCKET=
# @type=url @public
LEGAL_GAZETTE_CDN_URL=
# @type=port @public
LEGAL_GAZETTE_DB_PORT=
# @public
LEGAL_GAZETTE_MACHINE_CLIENT_SCOPES=
# @type=number @public
LG_SUBSCRIPTION_AMOUNT=
# @public
LG_SUBSCRIPTION_FEE_CODE=
# @public
LG_TBR_CHARGE_CATEGORY_COMPANY=
# @public
LG_TBR_CHARGE_CATEGORY_PERSON=
LG_TBR_CREDENTIALS=
# @type=number @public
LG_TBR_OFFICE_ID=
# @type=url @public
LG_TBR_PATH=
# @type=number @public
TBR_CHUNK_DELAY_MS=
# @type=number @public
TBR_CHUNK_SIZE=

# ---
# Required overrides for inherited items
# ---

# @public @required=forEnv(prod)
DB_HOST=
# @public @required=forEnv(prod)
DB_NAME=
# @required=forEnv(prod)
DB_PASS=
# @public @required=forEnv(prod)
DB_USER=
