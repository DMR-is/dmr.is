            "type": "string",
          },
          "signatureDate": {
            "description": "Date of signature",
            "type": "string",
          },
          "signatureText": {
            "description": "Rendered signature block HTML",
            "type": "string",
          },
          "signedDocumentUrl": {
            "description": "Link to signed PDF",
            "type": "string",
          },
          "text": {
            "description": "Regulation body HTML",
            "type": "string",
          },
          "title": {
            "description": "Regulation title",
            "type": "string",
          },
          "type": {
            "description": "Regulation type: base or amending",
            "type": "string",
          },
        },
        "required": [
          "draftingStatus",
          "title",
          "text",
          "draftingNotes",
        ],
        "type": "object",
      },
      "UpdateSignatureMember": {
        "properties": {
          "name": {
            "description": "The name/title/w.e. of the signature member",
            "type": "string",
          },
          "textAbove": {
            "description": "The text comes above the signature name",
            "nullable": true,
            "type": "string",
          },
          "textAfter": {
            "description": "The text that comes after the signature name",
            "nullable": true,
            "type": "string",
          },
          "textBefore": {
            "description": "The text that comes before the signature name",
            "nullable": true,
            "type": "string",
          },
          "textBelow": {
            "description": "The text that comes below the signature name",
            "nullable": true,
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateSignatureRecord": {
        "properties": {
          "additional": {
            "type": "string",
          },
          "institution": {
            "type": "string",
          },
          "signatureDate": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateTagBody": {
        "properties": {
          "tagId": {
            "type": "string",
          },
        },
        "required": [
          "tagId",
        ],
        "type": "object",
      },
      "UpdateTitleBody": {
        "properties": {
          "title": {
            "type": "string",
          },
        },
        "required": [
          "title",
        ],
        "type": "object",
      },
      "UpdateUserDto": {
        "properties": {
          "displayName": {
            "type": "string",
          },
          "email": {
            "type": "string",
          },
          "firstName": {
            "type": "string",
          },
          "involvedParties": {
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "lastName": {
            "type": "string",
          },
          "roleId": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "UserDto": {
        "properties": {
          "createdAt": {
            "type": "string",
          },
          "deletedAt": {
            "nullable": true,
            "type": "string",
          },
          "displayName": {
            "type": "string",
          },
          "email": {
            "type": "string",
          },
          "firstName": {
            "type": "string",
          },
          "fullName": {
            "type": "string",
          },
          "id": {
            "type": "string",
          },
          "involvedParties": {
            "items": {
              "$ref": "#/components/schemas/Institution",
            },
            "type": "array",
          },
          "lastName": {
            "type": "string",
          },
          "nationalId": {
            "type": "string",
          },
          "role": {
            "$ref": "#/components/schemas/UserRoleDto",
          },
          "updatedAt": {
            "type": "string",
          },
        },
        "required": [
          "id",
          "nationalId",
          "firstName",
          "lastName",
          "fullName",
          "email",
          "displayName",
          "involvedParties",
          "createdAt",
          "updatedAt",
          "deletedAt",
          "role",
        ],
        "type": "object",
      },
      "UserRoleDto": {
        "properties": {
