      "CaseStatus": {
        "properties": {
          "id": {
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851",
            "type": "string",
          },
          "slug": {
            "description": "Slug of the case staus",
            "example": "innsent",
            "type": "string",
          },
          "title": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CaseStatusEnum",
              },
            ],
            "description": "Status of the case",
