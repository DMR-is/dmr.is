          },
          "advertCategories": {
            "description": "List of advert categories.",
            "items": {
              "$ref": "#/components/schemas/Category",
            },
            "nullable": false,
            "type": "array",
          },
          "advertCorrections": {
            "description": "Corrections made to the related advert.",
            "items": {
              "$ref": "#/components/schemas/AdvertCorrection",
            },
            "type": "array",
          },
          "advertDepartment": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Department",
              },
            ],
            "description": "Advert department",
            "example": "B-Deild",
          },
          "advertId": {
            "description": "Id of the advert the case is related to.",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851",
            "nullable": true,
            "type": "string",
          },
          "advertTitle": {
            "description": "Advert title on case",
            "example": "Titill á máli",
            "type": "string",
          },
          "advertType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CaseDetailAdvertType",
              },
            ],
            "description": "The advert type",
          },
          "applicationId": {
            "description": "Id of the submitted application, default to null on older cases.",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851",
            "type": "string",
          },
          "applicationType": {
            "description": "Application type: ad, base_regulation, or amending_regulation",
            "example": "ad",
            "type": "string",
          },
          "assignedTo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserDto",
              },
            ],
            "description": "User the case is assigned to.",
            "nullable": true,
          },
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/ApplicationAttachment",
            },
            "type": "array",
          },
          "caseNumber": {
            "description": "Case number (numeric string) gets generated automatically when a case is created.",
            "example": 190,
            "type": "string",
          },
          "channels": {
            "description": "Channels for the case.",
            "example": {
              "email": "dmr@dmr.is",
              "id": "d290f1ee-6c54-4b01-90e6-d701748f0851",
              "phone": "+354 123 4567",
            },
            "items": {
              "$ref": "#/components/schemas/CaseChannel",
            },
            "type": "array",
          },
          "comments": {
            "description": "Comments on the case.",
            "example": {
              "createdAt": "2024-01-01T09:00:00Z",
              "id": "d290f1ee-6c54-4b01-90e6-d701748f0851",
              "task": {
                "comment": "Pálína, getur þú tekið við og staðfest að upplýsingarnar séu réttar?",
                "from": "Ármann",
                "title": "gerir athugasemd",
                "to": null,
              },
              "type": "Comment",
            },
            "items": {
              "$ref": "#/components/schemas/CommentDto",
            },
            "type": "array",
          },
          "communicationStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CommunicationStatus",
              },
            ],
            "description": "Status of communication with the applicant, default to \`CaseCommunicationStatus.NotStarted\`",
          },
          "createdAt": {
            "description": "Date the case was created. ISO 8601 date and time format in UTC.",
            "example": "2024-01-01T09:00:00Z",
            "type": "string",
          },
          "fastTrack": {
            "description": "Requested fast track",
            "example": false,
            "type": "boolean",
          },
          "hideSignatureDate": {
            "description": "Should hide display of signature date.",
            "example": false,
            "type": "boolean",
          },
          "history": {
            "description": "History of the case.",
            "items": {
              "$ref": "#/components/schemas/CaseHistory",
            },
            "type": "array",
          },
          "html": {
            "description": "The case html content.",
            "type": "string",
          },
          "id": {
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851",
            "type": "string",
          },
          "involvedParty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Institution",
              },
            ],
            "description": "Involved party of the case.",
          },
          "isLegacy": {
            "description": "Is legacy case.",
            "example": false,
            "type": "boolean",
          },
          "message": {
            "example": "Additional message from sender",
            "nullable": true,
            "type": "string",
          },
          "modifiedAt": {
            "description": "Date when the case was last updated. ISO 8601 date and time format in UTC.",
            "example": "2024-01-01T09:00:00Z",
            "type": "string",
          },
          "proposedAdvertId": {
            "description": "Propsed ID of the advert. Before advert is published.",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851",
            "nullable": true,
            "type": "string",
          },
          "publicationNumber": {
            "description": "Publication number of the case.",
            "type": "string",
          },
          "publishedAt": {
            "description": "Date the case was published. ISO 8601 date and time format in UTC.",
            "example": "2024-01-01T09:00:00Z",
            "nullable": true,
            "type": "string",
          },
          "regulationDraftId": {
            "description": "UUID reference to regulation draft in regulations-admin",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851",
            "nullable": true,
            "type": "string",
          },
          "requestedPublicationDate": {
            "description": "Requested advert publication date. ISO 8601 date and time format in UTC.",
            "example": "2024-01-01T09:00:00Z",
            "type": "string",
          },
          "signature": {
            "$ref": "#/components/schemas/Signature",
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CaseStatus",
              },
            ],
            "description": "Status of the case, default to "Innsent"",
          },
          "tag": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CaseTag",
              },
            ],
            "description": "Internal tag for the case, default to null",
          },
          "transaction": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CaseTransaction",
              },
            ],
            "description": "Case fee transaction.",
            "nullable": true,
          },
          "year": {
            "description": "Year the case was created.",
            "example": 2024,
            "type": "number",
          },
        },
        "required": [
          "id",
          "advertId",
          "proposedAdvertId",
          "year",
          "caseNumber",
          "status",
          "tag",
          "involvedParty",
          "additionalParties",
          "createdAt",
          "modifiedAt",
          "isLegacy",
          "hideSignatureDate",
          "assignedTo",
          "communicationStatus",
          "fastTrack",
          "publishedAt",
          "requestedPublicationDate",
          "advertTitle",
          "advertDepartment",
          "advertType",
          "advertCategories",
          "transaction",
          "message",
          "html",
          "publicationNumber",
          "channels",
          "comments",
          "signature",
          "attachments",
          "additions",
          "history",
        ],
        "type": "object",
      },
      "CaseHistory": {
