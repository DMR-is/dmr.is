    "/api/v1/adverts": {
      "get": {
        "operationId": "getAdverts",
        "parameters": [
          {
            "description": "String to search for in adverts.",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Page number to return.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "Page size to return.",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "One or more departments (by \`slug\`) to filter on.",
            "in": "query",
            "name": "department",
            "required": false,
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "description": "Year (signature year) to filter by",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "One or more types (by \`slug\`) to filter on.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "description": "One or more main types (by \`slug\`) to filter on.",
            "in": "query",
            "name": "mainType",
            "required": false,
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "description": "One or more categories (by \`slug\`) to filter on.",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "description": "One or more involved parties (by \`slug\`) to filter on.",
            "in": "query",
            "name": "involvedParty",
            "required": false,
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "description": "Date from which to filter adverts on, inclusive, takes into account \`createdDate\`, \`updatedDate\` and \`signatureDate\`.",
            "in": "query",
            "name": "dateFrom",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Date to which to filter adverts on, inclusive, takes into account \`createdDate\`, \`updatedDate\` and \`signatureDate\`.",
            "in": "query",
            "name": "dateTo",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "sortBy",
            "required": false,
            "schema": {
              "example": "sortBy",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "example": "ASC",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdvertsResponse",
                },
              },
            },
            "description": "",
          },
        },
        "summary": "",
      },
    },
