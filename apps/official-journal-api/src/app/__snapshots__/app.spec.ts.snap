      "Institution": {
        "properties": {
          "id": {
            "description": "Unique ID for the institution, GUID format.",
            "example": "00000000-0000-0000-0000-000000000000",
            "nullable": false,
            "type": "string",
          },
          "nationalId": {
            "description": "National ID of the institution",
            "example": "650376-2949",
            "type": "string",
          },
          "slug": {
            "description": "Slug of the institution, used in URLs and API requests.",
            "example": "domsmalaraduneytid",
            "type": "string",
          },
          "title": {
            "description": "Title of the institution",
            "example": "Dómsmálaráðuneytið",
            "type": "string",
          },
        },
        "required": [
          "id",
          "title",
          "slug",
          "nationalId",
        ],
        "type": "object",
      },
      "InternalServerErrorException": {
        "properties": {},
        "type": "object",
      },
      "IssueDto": {
        "properties": {
          "department": {
            "$ref": "#/components/schemas/Department",
          },
          "endDate": {
            "format": "date-time",
            "type": "string",
          },
          "formattedTitle": {
            "type": "string",
          },
          "id": {
            "type": "string",
          },
          "startDate": {
            "format": "date-time",
            "type": "string",
          },
          "title": {
            "type": "string",
          },
          "url": {
            "type": "string",
          },
        },
        "required": [
          "id",
          "department",
          "startDate",
          "endDate",
          "title",
          "formattedTitle",
          "url",
        ],
        "type": "object",
      },
      "MainCategory": {
        "properties": {
          "categories": {
            "description": "List of sub categories under this main category.",
            "items": {
              "$ref": "#/components/schemas/Category",
            },
            "type": "array",
          },
          "departmentId": {
            "description": "Department linked to category.",
            "example": "00000000-0000-0000-0000-000000000000",
            "type": "string",
          },
          "description": {
            "description": "Description of the main category, used on front page.",
            "example": "Hæstiréttur, lögmenn, lögreglumál, dómsmál og landsdómur.",
            "type": "string",
          },
          "id": {
            "description": "Unique ID for the main category, GUID format.",
            "example": "00000000-0000-0000-0000-000000000000",
            "nullable": false,
            "type": "string",
          },
          "slug": {
            "description": "Slug of the main category, used in URLs and API requests.",
            "example": "domstolar-og-rettarfar",
            "type": "string",
          },
          "title": {
            "description": "Title of the main category.",
            "example": "Dómstólar og réttarfar",
            "type": "string",
          },
        },
        "required": [
          "id",
          "title",
          "slug",
          "departmentId",
          "description",
          "categories",
        ],
        "type": "object",
      },
      "NotFoundException": {
        "properties": {},
        "type": "object",
      },
      "Paging": {
        "properties": {
          "hasNextPage": {
            "example": true,
            "type": "boolean",
          },
          "hasPreviousPage": {
            "example": false,
            "type": "boolean",
          },
          "nextPage": {
            "example": 2,
            "nullable": true,
            "type": "number",
          },
          "page": {
            "example": 1,
            "type": "number",
          },
          "pageSize": {
            "example": 10,
            "maximum": 100,
            "minimum": 1,
            "type": "number",
          },
          "previousPage": {
            "example": 1,
            "nullable": true,
            "type": "number",
          },
          "totalItems": {
            "example": 1000,
            "type": "number",
          },
          "totalPages": {
            "example": 10,
            "type": "number",
          },
        },
        "required": [
          "page",
          "totalPages",
          "totalItems",
          "nextPage",
          "previousPage",
          "pageSize",
          "hasNextPage",
          "hasPreviousPage",
        ],
        "type": "object",
      },
    },
  },
  "info": {
    "contact": {},
    "description": "API for advarts and publication in the Official Journal of Iceland.",
    "title": "The Official Journal of Iceland API",
    "version": "1.0",
  },
