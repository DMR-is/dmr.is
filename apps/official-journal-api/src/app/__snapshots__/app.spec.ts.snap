  "paths": {
    "/api/v1/advert-types/main-types": {
      "get": {
        "operationId": "getMainTypes",
        "parameters": [
          {
            "description": "Search by id",
            "in": "query",
            "name": "id",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Filter by unassigned",
            "in": "query",
            "name": "unassigned",
            "required": false,
            "schema": {
              "type": "boolean",
            },
          },
          {
            "description": "Search by main type id",
            "in": "query",
            "name": "mainType",
            "required": false,
