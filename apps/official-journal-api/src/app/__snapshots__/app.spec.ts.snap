              "type": "string",
            },
          },
          {
            "description": "Search by title",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Search by slug",
            "in": "query",
            "name": "slug",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Search by department slug, title or id",
            "in": "query",
            "name": "department",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "The page number",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "The page size",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdvertMainTypes",
                },
