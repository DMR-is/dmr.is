# Configuration specific to official-journal-api.
# Authoring rules and the shared items this imports: see the root schema.
#
# @defaultRequired=infer
# @currentEnv=$DMR_RUNTIME
# @import(../../, pick=[
#   ADMIN_API_TOKEN,
#   ADVERTS_CDN_URL,
#   ADVERTS_SEARCH_ALIAS,
#   ALLOW_DELETE_CONCRETE,
#   API_MOCK,
#   APPLICATION_PORT,
#   AWS_*,
#   CACHE_DEBUG,
#   DB_HOST,
#   DB_NAME,
#   DB_PASS,
#   DB_PORT,
#   DB_USER,
#   DMR_APPLICATION_API_BASE_PATH,
#   DMR_PDF_BASE_PATH,
#   ENABLE_REDIS,
#   FEE_SERVICE_*,
#   HOSTNAME,
#   IDENTITY_SERVER_DOMAIN,
#   INIT_SCHEMA,
#   ISLAND_IS_DMR_CLIENT_ID,
#   ISLAND_IS_DMR_CLIENT_SCOPES,
#   ISLAND_IS_DMR_CLIENT_SECRET,
#   ISLAND_IS_TOKEN_URL,
#   LOCAL_CHROMIUM_PATH,
#   LOG_LEVEL,
#   NODE_ENV,
#   OPENSEARCH_CLUSTER_ENDPOINT,
#   PORT,
#   REDIS_*,
#   REGULATIONS_ADMIN_API_URL,
#   REGULATIONS_API_PASSWORD,
#   REGULATIONS_API_URL,
#   REGULATIONS_API_USERNAME,
#   REGULATION_ACCESS_KEY,
#   REGULATION_SECRET_KEY,
#   REGULATION_SERVICE_KEY,
#   XROAD_*
# ])
# ---

# Declared per file because varlock resolves the currentEnv flag only against
# items in the same file. Rationale: DMR_RUNTIME in the root schema.
# @public @type=enum(local, deployed)
DMR_RUNTIME=deployed

# ---
# Required overrides for inherited items
# ---

# @public @required=forEnv(deployed)
DB_HOST=
# @public @required=forEnv(deployed)
DB_NAME=
# @required=forEnv(deployed)
DB_PASS=
# @public @required=forEnv(deployed)
DB_USER=
