# Configuration specific to directorate-of-equality-partner-api.
#
# The public third-party surface. It shares a database with
# directorate-of-equality-api and writes reports itself, so it needs the write
# path's configuration — but not the admin surface's.
#
# NOTE: decorator names must never appear with a leading at-sign in prose here.
# Varlock parses every at-token in a comment block as a decorator, so a sentence
# mentioning one is read as a redeclaration with the sentence as its value.
#
# Root decorators are per-file and do NOT propagate through an import, so the
# defaultRequired and currentEnv settings are repeated below.
#
# @defaultRequired=infer
# @currentEnv=$DMR_RUNTIME
# @import(../../, pick=[
#   AWS_*,
#   DB_*,
#   HOSTNAME,
#   LOG_LEVEL,
#   NATIONAL_REGISTRY_*,
#   NODE_ENV
# ])
# ---

# Declared per file because varlock resolves the currentEnv flag only against
# items in the same file. Rationale: DMR_RUNTIME in the root schema.
# @public @type=enum(local, deployed)
DMR_RUNTIME=deployed

# ---
# National registry / RSK
# ---

# @type=url @public
RSK_COMPANY_REGISTRY_API_PATH=
# @required=true
RSK_PRIMARY_KEY=
RSK_SECONDARY_KEY=

# ---
# Misc
# ---

# @type=port @public
DIRECTORATE_OF_EQUALITY_PARTNER_API_PORT=
# Read as a fallback rung by app.module.ts behind DB_PORT. Declared so the
# wrapper can scrub a value left in the shell for the sibling app.
# @type=port @public
DIRECTORATE_OF_EQUALITY_DB_PORT=

# Excel parse concurrency. This surface accepts workbooks from vendors, so the
# same limits apply as on the island.is one.
# @type=number @public
DOE_EXCEL_MAX_CONCURRENT_PARSES=
# @type=number @public
DOE_EXCEL_MAX_QUEUED_PARSES=

# ---
# Required in every environment
# ---

# @public @required=true
DB_HOST=
# @public @required=true
DB_NAME=
# @required=true
DB_PASS=
# @public @required=true
DB_USER=
# @type=port @public @required=true
DB_PORT=

# Every name below is verified present in the deployed task definitions, which
# is the precondition for marking anything required: a marker on a variable ECS
# does not set is an outage on the next deploy.
#
# Not marked: AWS_REGION and AWS_CREDENTIALS_SOURCE, which come from the task
# role or a laptop's AWS session, hence the varlock-run.sh scrub exemption.

# @public @required=forEnv(deployed)
AWS_SALARY_ANALYSIS_FILES_BUCKET=

# @public @required=true
NATIONAL_REGISTRY_API_LOGIN_PATH=
# @public @required=true
NATIONAL_REGISTRY_API_LOOKUP_PATH=
# @public @required=true
NATIONAL_REGISTRY_CLIENT_USER=
# @required=true
NATIONAL_REGISTRY_CLIENT_PASSWORD=

# The pepper every issued API key's digest is derived under. This service is the
# one that VERIFIES keys, so it needs the byte-identical value that
# directorate-of-equality-api issues them with — a shared secret between two
# services, not per-service configuration. A different value here rejects every
# key ever issued, and the symptom is a uniform 401 with nothing in either log
# pointing at a config mismatch.
#
# Must be at least 32 characters; MIN_PEPPER_LENGTH is enforced at hash and
# verify time so a placeholder is refused rather than silently accepted.
# @required=true
DOE_API_KEY_HMAC_SECRET=
