{
  "name": "directorate-of-equality-partner-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/directorate-of-equality-partner-api/src",
  "projectType": "application",
  "targets": {
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p tsconfig.app.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "cwd": "apps/directorate-of-equality-partner-api",
        "forwardAllArgs": false
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/directorate-of-equality-partner-api/jest.config.ts"
      }
    },
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "apps/directorate-of-equality-partner-api/dist",
        "main": "apps/directorate-of-equality-partner-api/src/main.ts",
        "tsConfig": "apps/directorate-of-equality-partner-api/tsconfig.app.json",
        "webpackConfig": "apps/directorate-of-equality-partner-api/webpack.config.js",
        "generatePackageJson": true
      },
      "configurations": {
        "development": {
          "outputHashing": "none"
        },
        "production": {}
      },
      "dependsOn": [
        "^build"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "nx format:write --projects=directorate-of-equality-partner-api",
          "nx run directorate-of-equality-partner-api:lint --fix=true --skip-nx-cache"
        ],
        "parallel": false
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/varlock-run.sh directorate-of-equality-partner-api nx run directorate-of-equality-partner-api:serve-raw"
      }
    },
    "serve-raw": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "directorate-of-equality-partner-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "directorate-of-equality-partner-api:build:development"
        },
        "production": {
          "buildTarget": "directorate-of-equality-partner-api:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": [
        "flatten-env"
      ],
      "options": {
        "engine": "docker",
        "metadata": {
          "load": true
        },
        "file": "apps/directorate-of-equality-partner-api/Dockerfile"
      }
    },
    "flatten-env": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "apps/directorate-of-equality-partner-api",
        "command": "../../node_modules/.bin/varlock flatten --out-dir dist/env && find dist/env -type f ! -name '.env.schema' -delete"
      }
    }
  }
}
