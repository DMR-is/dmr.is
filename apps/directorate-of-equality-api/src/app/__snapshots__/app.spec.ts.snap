    "/api/v1/application/reports/salary/eligibility": {
      "get": {
        "description": "Pre-flight check of whether the resolved company may submit a salary report right now, with a machine-readable \`reason\` when blocked so the application portal can gate entry into the flow. Two preconditions are checked: (1) the company must have an APPROVED, in-force equality report (\`MISSING_EQUALITY_REPORT\`, checked first — a salary report must reference one); and (2) the 3-year renewal window must be open, i.e. the current report is due in 6 months or less (\`RENEWAL_WINDOW_NOT_OPEN\`). The renewal rule is also enforced as a 409 on \`POST reports/salary\`, and the equality precondition as a 404.",
        "operationId": "getApplicationSalaryReportEligibility",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalaryReportEligibilityDto",
                },
              },
