      },
    },
    "/api/v1/application/reports/{providerId}": {
      "delete": {
        "description": "Withdraws the report tied to an island.is application the applicant deleted upstream. Sets status to \`WITHDRAWN\` and emits \`STATUS_CHANGED\`. Allowed only before the report reaches a terminal state (\`APPROVED\`/\`DENIED\`/\`SUPERSEDED\`); idempotent on an already-\`WITHDRAWN\` report.",
        "operationId": "withdrawApplicationReport",
        "parameters": [
          {
            "description": "Upstream submission ID (e.g. the island.is application UUID).",
            "in": "path",
            "name": "providerId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "204": {
            "description": "",
          },
          "400": {
