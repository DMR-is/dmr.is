        ],
        "summary": "",
        "tags": [
          "Application",
        ],
      },
      "get": {
        "description": "Returns company-facing report detail with external comments. Looked up by upstream \`providerId\`.",
        "operationId": "getApplicationReport",
        "parameters": [
          {
            "description": "Upstream submission ID (e.g. the island.is application UUID). Identifies the report by the originator's own handle rather than the DoE-side \`report.id\`, which the applicant does not see. Resolved against reports whose parent company matches the authenticated company.",
