      "ReportEmployeeOutlierDto": {
        "properties": {
          "action": {
            "nullable": true,
            "type": "string",
          },
          "adjustedBaseSalary": {
            "description": "Employee's full-time-equivalent base salary at submission, projected from the matching \`outlier_analysis_snapshot.employees\` entry. Null if the snapshot has no matching ordinal.",
            "nullable": true,
            "type": "number",
          },
          "allowedDifferencePercent": {
            "description": "Half-threshold band (in percent) used to flag this row as an outlier — i.e. the report-wide allowed deviation at submission time.",
            "nullable": true,
            "type": "number",
          },
          "differencePercent": {
            "description": "Signed percent deviation of the employee's adjusted base salary from the predicted salary.",
            "nullable": true,
            "type": "number",
          },
          "direction": {
            "description": "Sign of the deviation from the predicted salary: 'ABOVE' | 'BELOW' | 'EQUAL'. Null when no prediction was available.",
            "nullable": true,
            "type": "string",
          },
          "employeeOrdinal": {
            "description": "1-indexed ordinal of the outlier employee in the report's parsed employee list. Mirrors \`report_employee.ordinal\` — used to cross-reference the canonical detected set on \`report_result.outlier_analysis_snapshot.employees\`.",
            "nullable": true,
            "type": "number",
          },
          "gender": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GenderEnum",
              },
            ],
            "nullable": true,
          },
          "groupId": {
            "description": "Id of the outlier group this outlier belongs to. Every outlier always belongs to exactly one group.",
            "format": "uuid",
            "type": "string",
          },
          "groupName": {
            "description": "Name of the outlier group this outlier belongs to. Denormalized from the group for convenient client-side grouping/labeling.",
            "nullable": true,
            "type": "string",
          },
          "id": {
            "format": "uuid",
            "type": "string",
          },
          "predictedBaseSalary": {
            "description": "Salary predicted by the regression line at the employee's exact score. Null when the regression had no slope (insufficient sample) or no matching snapshot entry exists.",
            "nullable": true,
            "type": "number",
          },
          "reason": {
            "description": "Explanation shared by the group. Denormalized from the outlier group — every outlier in the same group carries the same value. Null only while the parent report has \`status = POSTPONED\`.",
            "nullable": true,
            "type": "string",
          },
          "reportEmployeeId": {
            "format": "uuid",
            "type": "string",
          },
          "roleTitle": {
            "nullable": true,
            "type": "string",
          },
          "score": {
            "nullable": true,
            "type": "number",
          },
          "scoreBucketRangeFrom": {
            "nullable": true,
            "type": "number",
          },
          "scoreBucketRangeTo": {
            "nullable": true,
            "type": "number",
          },
          "signatureName": {
            "nullable": true,
            "type": "string",
          },
          "signatureRole": {
            "nullable": true,
            "type": "string",
          },
        },
        "required": [
          "id",
          "reportEmployeeId",
          "groupId",
        ],
        "type": "object",
      },
