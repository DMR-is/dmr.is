    "/api/v1/companies": {
      "get": {
        "operationId": "getCompanies",
        "parameters": [
          {
            "description": "Return only companies whose report status is one of the provided values (same status shown on each company). Omit for no constraint.",
            "in": "query",
            "name": "companyStatus",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/CompanyReportStatusEnum",
              },
              "type": "array",
            },
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CompanySortDirectionEnum",
            },
          },
          {
            "description": "Return only companies whose employee-count bucket matches.",
            "in": "query",
            "name": "employeeCountCategory",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CompanySizeEnum",
            },
          },
          {
            "description": "Return only companies that have an approved report expiring within the given window. Multiple values are OR-ed; the largest window wins.",
            "in": "query",
            "name": "expiresWithin",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/CompanyExpiryFilterEnum",
              },
              "type": "array",
            },
          },
          {
            "description": "When true, return only companies in the daily-fines process (finesStarted = true).",
            "in": "query",
            "name": "finesStarted",
            "required": false,
            "schema": {
              "type": "boolean",
            },
          },
          {
            "description": "Return only companies whose admin-owned ÍSAT2008 category is one of the given leaf codes (e.g. "01110").",
            "in": "query",
            "name": "isatCategoryCode",
            "required": false,
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "description": "Return only companies whose ÍSAT2008 section (bálkur) is one of the given letters, e.g. "O" for public administration. Case-insensitive. The premade industry filter — resolved via the company ÍSAT category, so companies with no ÍSAT code are excluded.",
            "in": "query",
            "name": "isatSection",
            "required": false,
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "description": "When true, return only companies whose next equality or salary report due date has passed.",
            "in": "query",
            "name": "overdue",
            "required": false,
            "schema": {
              "type": "boolean",
            },
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "example": 1,
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 10,
              "example": 10,
              "type": "number",
            },
          },
          {
            "description": "Return only companies with one of the given postcodes (póstnúmer, e.g. "101").",
            "in": "query",
            "name": "postcode",
            "required": false,
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "description": "Free-text search on company name or national ID.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "When true, return only quarantined companies (quarantined = true).",
            "in": "query",
            "name": "quarantined",
            "required": false,
            "schema": {
              "type": "boolean",
            },
          },
          {
            "description": "Return only companies located in one of the given regions (landshluti), by region code (e.g. "CAPITAL"). Resolved via the company postcode.",
            "in": "query",
            "name": "regionCode",
            "required": false,
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "description": "Return only companies in one of the given ownership sectors — the premade "private vs government/state" filter. UNKNOWN is filterable on its own and is never included in PRIVATE.",
            "in": "query",
            "name": "sector",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/CompanySectorEnum",
              },
              "type": "array",
            },
          },
          {
            "in": "query",
            "name": "sortBy",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CompanySortByEnum",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCompaniesResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto",
                },
              },
            },
            "description": "",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto",
                },
              },
            },
            "description": "",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto",
                },
              },
            },
            "description": "",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto",
                },
              },
            },
            "description": "",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "",
        "tags": [
          "Companies",
        ],
      },
