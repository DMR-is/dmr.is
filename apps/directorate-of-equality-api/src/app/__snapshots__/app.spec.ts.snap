          "providerId": {
            "type": "string",
          },
          "salaryDataBasis": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SalaryDataBasisEnum",
              },
            ],
            "description": "Whether the salary data describes one specific payroll month (\`MONTH\`) or a twelve-month average (\`AVERAGE\`). The submittee must declare one.",
          },
          "salaryDataPeriod": {
            "description": "The payroll month the data is based on, as an ISO date (\`YYYY-MM-DD\`; any day within the month is accepted and normalised to the 1st). Required when \`salaryDataBasis\` is \`MONTH\`, ignored for \`AVERAGE\`. Must name a month that has already happened, no earlier than 36 months ago.",
            "nullable": true,
            "type": "string",
          },
          "subsidiaries": {
            "items": {
              "$ref": "#/components/schemas/SubmitReportSubsidiaryDto",
            },
            "type": "array",
          },
        },
        "required": [
          "equalityReportId",
          "identifier",
          "importedFromExcel",
          "providerId",
          "companyAdminName",
          "companyAdminEmail",
          "companyAdminGender",
          "contactName",
          "contactEmail",
          "contactPhone",
          "averageEmployeeMaleCount",
          "averageEmployeeFemaleCount",
          "averageEmployeeNeutralCount",
          "salaryDataBasis",
          "parsed",
          "company",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "contact": {},
    "description": "Public-facing API for equality report submissions through island.is. Covers company information lookup, Excel template download, workbook import, salary analysis, and equality report submission. Consumed by the island.is application system on behalf of employers.",
