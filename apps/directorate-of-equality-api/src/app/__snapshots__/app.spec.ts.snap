    "/api/v1/application/reports/{providerId}/comments": {
      "get": {
        "description": "The report's external comment thread on its own, ordered oldest-first. Only comments with \`EXTERNAL\` visibility are returned — reviewer-internal notes are never exposed to the applicant. Use this instead of re-fetching the report detail when only the conversation is needed; the same list is embedded as \`externalComments\` in \`GET /application/reports/:providerId\`.",
        "operationId": "getApplicationReportComments",
        "parameters": [
          {
            "description": "Upstream submission ID (e.g. the island.is application UUID).",
            "in": "path",
            "name": "providerId",
            "required": true,
