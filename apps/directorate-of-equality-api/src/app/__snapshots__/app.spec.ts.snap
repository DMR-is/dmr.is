    "/api/v1/reports": {
      "get": {
        "operationId": "listReports",
        "parameters": [
          {
            "in": "query",
            "name": "approvedFrom",
            "required": false,
            "schema": {
              "example": "2026-02-19T10:30:00.000Z",
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "approvedTo",
            "required": false,
            "schema": {
              "example": "2026-02-19T10:30:00.000Z",
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "correctionDeadlineFrom",
            "required": false,
            "schema": {
              "example": "2026-02-19T10:30:00.000Z",
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "correctionDeadlineTo",
            "required": false,
            "schema": {
              "example": "2026-02-19T10:30:00.000Z",
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "createdFrom",
            "required": false,
            "schema": {
              "example": "2026-02-19T10:30:00.000Z",
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "createdTo",
            "required": false,
            "schema": {
              "example": "2026-02-19T10:30:00.000Z",
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortDirectionEnum",
            },
          },
          {
            "description": "When true, returns only reports that have at least one employee outlier (i.e. an improvement plan applies). When false, returns only reports with no outliers. Omit for no constraint.",
            "in": "query",
            "name": "hasImprovementPlan",
            "required": false,
            "schema": {
              "type": "boolean",
            },
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "example": 1,
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 10,
              "example": 10,
              "type": "number",
            },
          },
          {
            "description": "Free-text search across company name, kennitala, and report identifier. Case-insensitive partial match. Person fields (contacts and company admin/CEO) are not searched.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "reviewerUserId",
            "required": false,
            "schema": {
              "items": {
                "format": "uuid",
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "in": "query",
            "name": "sortBy",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ReportSortByEnum",
            },
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/ReportStatusEnum",
              },
              "type": "array",
            },
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/ReportTypeEnum",
              },
              "type": "array",
            },
          },
          {
            "description": "When true, returns only reports with no reviewer assigned. Overrides \`reviewerUserId\` if both are set.",
            "in": "query",
            "name": "unassignedReviewer",
            "required": false,
            "schema": {
              "type": "boolean",
            },
          },
          {
            "in": "query",
            "name": "validUntilFrom",
            "required": false,
            "schema": {
              "example": "2026-02-19T10:30:00.000Z",
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "validUntilTo",
            "required": false,
            "schema": {
              "example": "2026-02-19T10:30:00.000Z",
              "format": "date-time",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetReportsResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto",
                },
              },
            },
            "description": "",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto",
                },
              },
            },
            "description": "",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto",
                },
              },
            },
            "description": "",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto",
                },
              },
            },
            "description": "",
          },
        },
        "security": [
          {
