# Configuration specific to directorate-of-equality-api.
# Authoring rules and the shared items this imports: see the root schema.
#
# @defaultRequired=infer
# @currentEnv=$DMR_RUNTIME
# @import(../../, pick=[
#   ADVERTS_CDN_URL,
#   AWS_*,
#   CACHE_DEBUG,
#   DB_*,
#   ENABLE_REDIS,
#   HOSTNAME,
#   IDENTITY_SERVER_DOMAIN,
#   INIT_SCHEMA,
#   ISLAND_IS_DMR_CLIENT_ID,
#   ISLAND_IS_DMR_CLIENT_SCOPES,
#   ISLAND_IS_DMR_CLIENT_SECRET,
#   ISLAND_IS_TOKEN_URL,
#   LOCAL_CHROMIUM_PATH,
#   LOG_LEVEL,
#   NATIONAL_REGISTRY_*,
#   NODE_ENV,
#   SEND_FROM_EMAIL_ADDRESS,
#   XROAD_DMR_CLIENT,
#   XROAD_ISLAND_IS_PATH
# ])
# ---

# Declared per file because varlock resolves the currentEnv flag only against
# items in the same file. Rationale: DMR_RUNTIME in the root schema.
# @public @type=enum(local, deployed)
DMR_RUNTIME=deployed

# ---
# National registry / RSK
# ---

# @type=url @public
RSK_COMPANY_REGISTRY_API_PATH=
# @required=true
RSK_PRIMARY_KEY=
RSK_SECONDARY_KEY=

# ---
# Misc
# ---

# @type=port @public
DIRECTORATE_OF_EQUALITY_API_PORT=
# @type=port @public
DIRECTORATE_OF_EQUALITY_DB_PORT=
# @type=number @public
DOE_EXCEL_MAX_CONCURRENT_PARSES=
# @type=number @public
DOE_EXCEL_MAX_QUEUED_PARSES=

# ---
# Required in every environment
# ---

# @public @required=true
DB_HOST=
# @public @required=true
DB_NAME=
# @required=true
DB_PASS=
# @public @required=true
DB_USER=

# Every name below is verified present in the deployed task definitions, which
# is the precondition for marking anything required: a marker on a variable ECS
# does not set is an outage on the next deploy.
#
# Not marked: AWS_REGION and AWS_CREDENTIALS_SOURCE, which come from the task
# role or a laptop's AWS session, hence the varlock-run.sh scrub exemption.

# @type=port @public @required=true
DB_PORT=
# @public @required=true
IDENTITY_SERVER_DOMAIN=
# @public @required=true
SEND_FROM_EMAIL_ADDRESS=
# @public @required=true
XROAD_DMR_CLIENT=
# @type=url @public @required=true
XROAD_ISLAND_IS_PATH=
# @public @required=forEnv(deployed)
AWS_SALARY_ANALYSIS_FILES_BUCKET=
# @type=url @public @required=true
ISLAND_IS_TOKEN_URL=
# @public @required=true
ISLAND_IS_DMR_CLIENT_ID=
# @required=true
ISLAND_IS_DMR_CLIENT_SECRET=
# @public @required=true
ISLAND_IS_DMR_CLIENT_SCOPES=
# @type=url @public @required=true
NATIONAL_REGISTRY_API_LOGIN_PATH=
# @type=url @public @required=true
NATIONAL_REGISTRY_API_LOOKUP_PATH=
# @public @required=true
NATIONAL_REGISTRY_CLIENT_USER=
# @required=true
NATIONAL_REGISTRY_CLIENT_PASSWORD=

# Server-side HMAC secret for third-party integration API keys -- a pepper, in
# the precise sense: server-wide and never stored, as opposed to a salt, which
# is per-record and kept beside the digest. Only the digest of a key's secret
# half goes into doe_api_key, so this value is what makes a leak of that table
# insufficient to verify a guessed key.
#
# Two consequences worth knowing before touching it:
#
# Rotating it invalidates every key ever issued, because no plaintext secret is
# recoverable to re-derive a digest from. Rotation means reissuing to every
# integrator, so it is a migration, not a config change.
#
# The partner API verifies keys and therefore needs the IDENTICAL value. It is a
# shared secret between two services, not per-service configuration.
#
# The app boots without it -- only issuing and verifying need it -- but it is
# marked required anyway: an API that accepts machine credentials it cannot
# verify is misconfigured, and finding that out on the first integrator request
# is worse than finding it out at boot.
# @required=true
DOE_API_KEY_HMAC_SECRET=
