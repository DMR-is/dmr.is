# Configuration specific to directorate-of-equality-api.
# Authoring rules and the shared items this imports: see the root schema.
#
# @defaultRequired=infer
# @currentEnv=$DMR_RUNTIME
# @import(../../, pick=[
#   ADVERTS_CDN_URL,
#   AWS_*,
#   CACHE_DEBUG,
#   DB_*,
#   DOE_API_KEY_HMAC_SECRET,
#   ENABLE_REDIS,
#   HOSTNAME,
#   IDENTITY_SERVER_DOMAIN,
#   INIT_SCHEMA,
#   ISLAND_IS_DMR_CLIENT_ID,
#   ISLAND_IS_DMR_CLIENT_SCOPES,
#   ISLAND_IS_DMR_CLIENT_SECRET,
#   ISLAND_IS_TOKEN_URL,
#   LOCAL_CHROMIUM_PATH,
#   LOG_LEVEL,
#   NATIONAL_REGISTRY_*,
#   NODE_ENV,
#   SEND_FROM_EMAIL_ADDRESS,
#   XROAD_DMR_CLIENT,
#   XROAD_ISLAND_IS_PATH
# ])
# ---

# Declared per file because varlock resolves the currentEnv flag only against
# items in the same file. Rationale: DMR_RUNTIME in the root schema.
# @public @type=enum(local, deployed)
DMR_RUNTIME=deployed

# @type=enum(dev, prod) @public @required=forEnv(deployed)
API_ENV=

# ---
# National registry / RSK
# ---

# @type=url @public
RSK_COMPANY_REGISTRY_API_PATH=
# @required=true
RSK_PRIMARY_KEY=
RSK_SECONDARY_KEY=

# ---
# OneSystems (OneExternalAPI → island.is Pósthólf)
# ---

# Kill switch for mailbox delivery. Anything other than the literal string
# "true" leaves delivery off, with no row, no render and no network call. An
# enum rather than a boolean type so the accepted values are exactly the two
# strings the code compares against.
#
# All four items here are optional, deliberately: nothing is provisioned in the
# deployed task definitions yet, and a requiredness marker on a variable ECS
# does not set is an outage on the next deploy. Delivery stays off until they
# exist, so an unset value is a safe state, not a misconfiguration.
# @type=enum("true", "false") @public @required=false
ONESYSTEMS_ENABLED=
# Base URL of the Jafnréttisstofa One instance's OneExternalAPI.
# @type=url @public @required=false
ONESYSTEMS_API_URL=
# Credentials for the OneExternalAPI Login call.
# @required=false
ONESYSTEMS_USERNAME=
# @required=false
ONESYSTEMS_PASSWORD=

# ---
# Misc
# ---

# @type=port @public
DIRECTORATE_OF_EQUALITY_API_PORT=
# @type=port @public
DIRECTORATE_OF_EQUALITY_DB_PORT=
# @type=number @public
DOE_EXCEL_MAX_CONCURRENT_PARSES=
# @type=number @public
DOE_EXCEL_MAX_QUEUED_PARSES=

# ---
# Required in every environment
# ---

# @public @required=true
DB_HOST=
# @public @required=true
DB_NAME=
# @required=true
DB_PASS=
# @public @required=true
DB_USER=

# Every name below is verified present in the deployed task definitions, which
# is the precondition for marking anything required: a marker on a variable ECS
# does not set is an outage on the next deploy.
#
# Not marked: AWS_REGION and AWS_CREDENTIALS_SOURCE, which come from the task
# role or a laptop's AWS session, hence the varlock-run.sh scrub exemption.

# @type=port @public @required=true
DB_PORT=
# @public @required=true
IDENTITY_SERVER_DOMAIN=
# @public @required=true
SEND_FROM_EMAIL_ADDRESS=
# @public @required=true
XROAD_DMR_CLIENT=
# @type=url @public @required=true
XROAD_ISLAND_IS_PATH=
# @public @required=forEnv(deployed)
AWS_SALARY_ANALYSIS_FILES_BUCKET=
# Documents the Directorate issues to companies -- the approved report PDFs its
# approval mail attaches -- filed under
# company-files/{companyNationalId}/{YYYY-MM-DD}-{filename}.
#
# Declared here rather than in the root schema, following LEGAL_GAZETTE_BUCKET.
# The read lives in doe-modules' CompanyFileService, which both DoE APIs could
# consume, but only this app wires the report-workflow module that calls it --
# partner-api never reaches that code. If it ever does, this item has to be
# repeated in its schema, or archiving there is silently off with nothing in the
# schema to say so. Deliberately not
# AWS_SALARY_ANALYSIS_FILES_BUCKET: that one receives applicant-uploaded Excel
# workbooks over presigned PUT, these are outbound issued documents with a
# locked read path.
#
# Optional, deliberately: the bucket does not exist yet, and CompanyFileService
# treats an unset value as "archiving is off" rather than erroring, so an
# approval still mails the company its documents. Tighten this to the same
# requiredness as AWS_SALARY_ANALYSIS_FILES_BUCKET once the bucket is
# provisioned -- otherwise production can silently run with archiving disabled.
#
# Relying on the inferred default would leave the same behaviour undeclared, and
# an unmarked item is treated as sensitive, which would redact a bucket name that
# is not a secret.
# @public @required=false
AWS_DOE_COMPANY_FILES_BUCKET=
# @type=url @public @required=true
ISLAND_IS_TOKEN_URL=
# @public @required=true
ISLAND_IS_DMR_CLIENT_ID=
# @required=true
ISLAND_IS_DMR_CLIENT_SECRET=
# @public @required=true
ISLAND_IS_DMR_CLIENT_SCOPES=
# @type=url @public @required=true
NATIONAL_REGISTRY_API_LOGIN_PATH=
# @type=url @public @required=true
NATIONAL_REGISTRY_API_LOOKUP_PATH=
# @public @required=true
NATIONAL_REGISTRY_CLIENT_USER=
# @required=true
NATIONAL_REGISTRY_CLIENT_PASSWORD=

# DOE_API_KEY_HMAC_SECRET is declared in the root schema, as a secret shared
# with directorate-of-equality-partner-api, and picked above. Re-declared here
# only for its requiredness on this service.
#
# It SHOULD be required: an API that issues credentials it cannot hash is
# misconfigured, and finding out on the first issuance is worse than at boot.
# Deliberately left unmarked for now. varlock enforces requiredness at container
# start (the Dockerfile CMD wraps migrations and main.js in `varlock run`), and
# marking a variable before its value was provisioned crashlooped the dev deploy
# of #1428, surfacing only as `Waiter ServicesStable failed: Max attempts
# exceeded`. Restore the requiredness decorator once
# /ecs/directorate-of-equality/DOE_API_KEY_HMAC_SECRET exists in BOTH the dev and
# prod accounts, because _envcommon stages the two together. Until then it falls
# back to the file's inferred default.
DOE_API_KEY_HMAC_SECRET=
