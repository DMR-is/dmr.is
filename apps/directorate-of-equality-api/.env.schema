# Configuration specific to directorate-of-equality-api.
#
# Shared items (database, redis, AWS, identity server, ...) are inherited from
# the root schema — but only the ones this app actually reads, so validation
# here means "this app can boot", not "the monorepo is fully configured".
# This file declares what is unique to the app, plus the required-overrides for
# what it genuinely cannot start without.
#
# NOTE: decorator names must never appear with a leading at-sign in prose here.
# Varlock parses every at-token in a comment block as a decorator, so a sentence
# mentioning one is read as a redeclaration with the sentence as its value.
#
# Root decorators are per-file and do NOT propagate through an import, so the
# defaultRequired and currentEnv settings are repeated below. Without the first,
# every item defaults to required; without the second, every forEnv() call fails
# with "current environment is not set".
#
# TypeScript type generation is intentionally NOT enabled yet. Nothing imports
# the generated ENV, the output is gitignored, and varlock emits its ts-nocheck
# pragma on the line above its eslint-disable, so the file fails this repo's
# ban-ts-comment rule and breaks nx lint. When types are wired up, add:
#   generateTsTypes(path=./env.ts, exposeEnv=local)   [with a leading at-sign]
# exposeEnv=local is required in a monorepo — without it every package augments
# the single global varlock/env module and the schemas merge.
#
# @defaultRequired=infer
# @currentEnv=$API_ENV
# @import(../../, pick=[
#   ADVERTS_CDN_URL,
#   AWS_*,
#   CACHE_DEBUG,
#   DB_*,
#   ENABLE_REDIS,
#   HOSTNAME,
#   IDENTITY_SERVER_DOMAIN,
#   INIT_SCHEMA,
#   ISLAND_IS_DMR_CLIENT_ID,
#   ISLAND_IS_DMR_CLIENT_SCOPES,
#   ISLAND_IS_DMR_CLIENT_SECRET,
#   ISLAND_IS_TOKEN_URL,
#   LOCAL_CHROMIUM_PATH,
#   LOG_LEVEL,
#   NATIONAL_REGISTRY_*,
#   NODE_ENV,
#   SEND_FROM_EMAIL_ADDRESS,
#   XROAD_DMR_CLIENT,
#   XROAD_ISLAND_IS_PATH
# ])
# ---

# Deployment environment. Declared here rather than imported: varlock requires
# the currentEnv flag to live in the same file as the decorator. Set by ECS when
# deployed, defaults to dev locally.
# @public @type=enum(dev, prod)
API_ENV=dev

# ---
# National registry / RSK
# ---

# @type=url @public
RSK_COMPANY_REGISTRY_API_PATH=
# @required=true
RSK_PRIMARY_KEY=
RSK_SECONDARY_KEY=

# ---
# Misc
# ---

# @type=port @public
DIRECTORATE_OF_EQUALITY_API_PORT=
# @type=port @public
DIRECTORATE_OF_EQUALITY_DB_PORT=
# @type=number @public
DOE_EXCEL_MAX_CONCURRENT_PARSES=
# @type=number @public
DOE_EXCEL_MAX_QUEUED_PARSES=

# ---
# Required in every environment
# ---
#
# Unconditional rather than forEnv(prod), because dev and prod are not different
# shapes: every per-environment terragrunt directory is include-only, so both
# environments get their names from the same _envcommon file and differ only in
# values. forEnv(prod) would therefore have exempted nothing on the ECS side --
# it would only have skipped local development, leaving the production deploy as
# the first time the schema was ever exercised. Dev is the only pre-prod surface
# there is; it should fail first.
#
# Consequence: local development needs this app's 1Password environment to be
# complete. That is the intent -- an empty value here means the app is
# misconfigured in any environment, not just prod.

# @public @required=true
DB_HOST=
# @public @required=true
DB_NAME=
# @required=true
DB_PASS=
# @public @required=true
DB_USER=

# Every name below is verified present in
# DMR-Jafnrettisstofa/_envcommon/doe_api.hcl. See the note in legal-gazette-api's
# schema for why that verification is the precondition for asserting forEnv(prod).
#
# AWS_SALARY_ANALYSIS_FILES_BUCKET already throws when absent
# (libs/shared/utils/server/src/lib/serverUtils.ts:136), so this only moves the
# failure to boot and names the variable.
#
# NOT marked: AWS_REGION and AWS_CREDENTIALS_SOURCE. ECS sets neither -- region and
# credentials come from the task role -- which is also why scripts/varlock-run.sh
# exempts them from the scrub.

# @type=port @public @required=true
DB_PORT=
# @public @required=true
IDENTITY_SERVER_DOMAIN=
# @public @required=true
SEND_FROM_EMAIL_ADDRESS=
# @public @required=true
XROAD_DMR_CLIENT=
# @type=url @public @required=true
XROAD_ISLAND_IS_PATH=
# @public @required=true
AWS_SALARY_ANALYSIS_FILES_BUCKET=
# @type=url @public @required=true
ISLAND_IS_TOKEN_URL=
# @public @required=true
ISLAND_IS_DMR_CLIENT_ID=
# @required=true
ISLAND_IS_DMR_CLIENT_SECRET=
# @public @required=true
ISLAND_IS_DMR_CLIENT_SCOPES=
# @type=url @public @required=true
NATIONAL_REGISTRY_API_LOGIN_PATH=
# @type=url @public @required=true
NATIONAL_REGISTRY_API_LOOKUP_PATH=
# @public @required=true
NATIONAL_REGISTRY_CLIENT_USER=
# @required=true
NATIONAL_REGISTRY_CLIENT_PASSWORD=
