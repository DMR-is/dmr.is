# Configuration specific to directorate-of-equality-partner-web.
# Authoring rules and the shared items this imports: see the root schema.
#
# @defaultRequired=infer
# @currentEnv=$DMR_RUNTIME
# @import(../../, pick=[
#   ANALYZE,
#   API_MOCKS,
#   BASE_URL,
#   DOE_API_BASE_PATH,
#   IDENTITY_SERVER_DOMAIN,
#   LOG_LEVEL,
#   NEXTAUTH_*,
#   NODE_ENV,
#   VERCEL_URL
# ])
# ---

# Declared per file because varlock resolves the currentEnv flag only against
# items in the same file. Rationale: DMR_RUNTIME in the root schema.
# @public @type=enum(local, deployed)
DMR_RUNTIME=deployed


# ---
# Required at container boot
# ---
#
# Every name below is set by this app's ECS task definition and by the local
# 1Password environment, the same names in both -- one shape to get right, not
# two.
#
# The image is built with an empty environment and run with these present, so
# this validates at boot, not at build. Nothing here may be read at build time.

# @required=true
BASE_URL=
# @required=true
NEXTAUTH_URL=
# @required=true
NEXTAUTH_SECRET=
# @required=true
IDENTITY_SERVER_DOMAIN=
# @required=true
DOE_API_BASE_PATH=
# This is a NEW island.is IDS client for the partner web app, distinct from
# DOE_WEB_CLIENT_ID/_SECRET (directorate-of-equality-web's staff-facing
# client), owned by another team. Deployed values come from SSM under
# /ecs/directorate-of-equality/doe_partner_web_client_{id,secret}, local values
# from this app's own 1Password environment. Whether the dev SSM values are a
# real IDS client is still pending confirmation; until it is, the container boots
# but sign-in fails.
# @required=true @public
DOE_PARTNER_WEB_CLIENT_ID=
# @required=true
DOE_PARTNER_WEB_CLIENT_SECRET=
