# Configuration specific to legal-gazette-public-web.
#
# Shared items (database, redis, AWS, identity server, ...) are inherited from
# the root schema — but only the ones this app actually reads, so validation
# here means "this app can boot", not "the monorepo is fully configured".
# This file declares what is unique to the app, plus the required-overrides for
# what it genuinely cannot start without.
#
# NOTE: decorator names must never appear with a leading at-sign in prose here.
# Varlock parses every at-token in a comment block as a decorator, so a sentence
# mentioning one is read as a redeclaration with the sentence as its value.
#
# Root decorators are per-file and do NOT propagate through an import, so the
# defaultRequired and currentEnv settings are repeated below. Without the first,
# every item defaults to required; without the second, every forEnv() call fails
# with "current environment is not set".
#
# TypeScript type generation is intentionally NOT enabled yet. Nothing imports
# the generated ENV, the output is gitignored, and varlock emits its ts-nocheck
# pragma on the line above its eslint-disable, so the file fails this repo's
# ban-ts-comment rule and breaks nx lint. When types are wired up, add:
#   generateTsTypes(path=./env.ts, exposeEnv=local)   [with a leading at-sign]
# exposeEnv=local is required in a monorepo — without it every package augments
# the single global varlock/env module and the schemas merge.
#
# @defaultRequired=infer
# @currentEnv=$DMR_RUNTIME
# @import(../../, pick=[
#   ANALYZE,
#   BASE_URL,
#   DMR_ADMIN_API_BASE_PATH,
#   IDENTITY_SERVER_*,
#   ISLAND_IS_DMR_WEB_CLIENT_ID,
#   ISLAND_IS_DMR_WEB_CLIENT_SECRET,
#   LOG_LEVEL,
#   NEXTAUTH_*,
#   NODE_ENV
# ])
# ---

# Whether this process is deployed or running on a developer machine. Gates
# required=forEnv(deployed) [with a leading at-sign], the per-item exemption for a
# value a laptop cannot have. Declared here because varlock resolves the currentEnv
# flag only against items in the same file.
#
# Defaults to deployed, so ECS sets nothing and a missing override fails closed.
# Overridden by scripts/varlock-run.sh and by each web docker-compose.yml.
# @public @type=enum(local, deployed)
DMR_RUNTIME=deployed

# ---
# Misc
# ---

# ---
# Required at container boot
# ---
#
# This app's ECS task definition sets every name below, identically in dev and
# prod (utgafa/_envcommon/legal_gazette_public_web.hcl:105-118), and the local
# 1Password environment supplies the same names with local values, so requiredness
# is unconditional -- one shape to get right rather than two.
# required=forEnv(deployed) [with a leading at-sign] exempts a laptop per item.
#
# Requiredness is also NOT gated on NODE_ENV. Every dev-vs-prod branch this app
# used to carry existed only because all apps shared one shell -- local dev read
# LG_PUBLIC_WEB_URL / LG_PUBLIC_WEB_CLIENT_ID and switched back to the
# deployed names in production. Configuration resolves per app now, so the local
# 1Password environment supplies these same names with local values and there is
# one code path instead of two. DMR_ADMIN_API_BASE_PATH is the one name local dev
# does not strictly need today, because api-client/createClient still hardcodes
# localhost:4100 off NODE_ENV; it is required here anyway and set locally, so
# that branch can go away without a schema change.
#
# The image is built with an empty environment and run with these present, so
# this validates at boot, not at build. Nothing here may be read at build time.

# @required=true
BASE_URL=
# @required=true
NEXTAUTH_URL=
# @required=true
NEXTAUTH_SECRET=
# @required=true
IDENTITY_SERVER_DOMAIN=
# Read as the redirect fallback in shared auth (token-service.ts), not by this
# app directly -- do not drop it because grep over apps/ comes up empty.
# @required=true
IDENTITY_SERVER_LOGOUT_URL=
# @required=true
DMR_ADMIN_API_BASE_PATH=
# @required=true @public
ISLAND_IS_DMR_WEB_CLIENT_ID=
# @required=true
ISLAND_IS_DMR_WEB_CLIENT_SECRET=
