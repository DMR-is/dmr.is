          },
        },
        "required": [
          "fileName",
          "originalFileName",
          "fileFormat",
          "fileExtension",
          "fileLocation",
          "fileSize",
        ],
        "type": "object",
      },
      "PostApplicationComment": {
        "properties": {
          "applicationUserName": {
            "description": "Name of the user making the application comment.",
            "type": "string",
          },
          "comment": {
            "description": "The case comment itself",
            "type": "string",
          },
        },
        "required": [
          "comment",
        ],
        "type": "object",
      },
      "PresignedUrlResponse": {
        "properties": {
          "attachmentId": {
            "type": "string",
          },
          "cdn": {
            "type": "string",
          },
          "key": {
            "type": "string",
          },
          "url": {
            "type": "string",
          },
        },
        "required": [
          "url",
        ],
        "type": "object",
      },
      "S3UploadFileResponse": {
        "properties": {
          "filename": {
            "description": "Filename of the uploaded file.",
            "type": "string",
          },
          "size": {
            "description": "The size of the uploaded file.",
            "type": "number",
          },
          "url": {
            "description": "The URL of the uploaded file.",
            "type": "string",
          },
        },
        "required": [
          "url",
          "filename",
          "size",
        ],
        "type": "object",
      },
      "S3UploadFilesResponse": {
        "properties": {
          "files": {
            "description": "The uploaded files.",
            "items": {
              "$ref": "#/components/schemas/S3UploadFileResponse",
            },
            "type": "array",
          },
        },
        "required": [
          "files",
        ],
        "type": "object",
      },
      "Signature": {
        "properties": {
          "created": {
            "description": "ISO datestring of the creation date",
            "type": "string",
          },
          "html": {
            "description": "HTML of the signature",
            "type": "string",
          },
          "id": {
            "description": "The id of the signature",
            "type": "string",
          },
          "involvedParty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Institution",
              },
            ],
            "description": "The involved party of the signature",
          },
          "records": {
            "description": "The signature record",
            "items": {
              "$ref": "#/components/schemas/SignatureRecord",
            },
            "type": "array",
          },
          "signatureDate": {
            "description": "ISO datestring of the signature",
            "type": "string",
          },
        },
        "required": [
          "id",
          "signatureDate",
          "involvedParty",
          "html",
          "created",
          "records",
        ],
        "type": "object",
      },
      "SignatureMember": {
        "properties": {
          "id": {
            "description": "The id of the signature member",
            "type": "string",
          },
          "name": {
            "description": "The name/title/w.e. of the signature member",
            "type": "string",
          },
          "textAbove": {
            "description": "The text comes above the signature name",
            "nullable": true,
            "type": "string",
          },
          "textAfter": {
            "description": "The text that comes after the signature name",
            "nullable": true,
            "type": "string",
          },
          "textBefore": {
            "description": "The text that comes before the signature name",
            "nullable": true,
            "type": "string",
          },
          "textBelow": {
            "description": "The text that comes below the signature name",
            "nullable": true,
            "type": "string",
          },
        },
        "required": [
          "id",
          "name",
          "textAbove",
          "textBefore",
          "textBelow",
          "textAfter",
        ],
        "type": "object",
      },
      "SignatureRecord": {
        "properties": {
          "additional": {
            "nullable": true,
            "type": "string",
          },
          "chairman": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SignatureMember",
              },
            ],
            "nullable": true,
          },
          "id": {
            "type": "string",
          },
          "institution": {
            "type": "string",
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/SignatureMember",
            },
            "type": "array",
          },
          "signatureDate": {
            "type": "string",
          },
        },
        "required": [
          "id",
          "institution",
          "signatureDate",
          "additional",
          "chairman",
          "members",
        ],
        "type": "object",
      },
    },
  },
  "info": {
    "contact": {},
    "description": "This api is responsible for communications with the island.is application system.",
    "title": "The Official Journal of Iceland Application API",
    "version": "1.0",
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/advert-types/main-types": {
      "get": {
        "operationId": "getMainTypes",
        "parameters": [
          {
            "description": "Search by department slug, title or id",
            "in": "query",
            "name": "department",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Search by id",
            "in": "query",
            "name": "id",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Search by main type id",
            "in": "query",
            "name": "mainType",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "The page number",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "The page size",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "Search by title",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Search by slug",
            "in": "query",
            "name": "slug",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Filter by unassigned",
            "in": "query",
            "name": "unassigned",
            "required": false,
            "schema": {
              "type": "boolean",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdvertMainTypes",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvertTypeError",
                },
              },
            },
            "description": "",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvertTypeError",
                },
              },
            },
            "description": "",
          },
        },
        "summary": "",
      },
    },
