      "Institution": {
        "properties": {
          "id": {
            "description": "Unique ID for the institution, GUID format.",
            "example": "00000000-0000-0000-0000-000000000000",
            "nullable": false,
            "type": "string",
          },
          "nationalId": {
            "description": "National ID of the institution",
            "example": "650376-2949",
            "type": "string",
          },
          "slug": {
            "description": "Slug of the institution, used in URLs and API requests.",
            "example": "domsmalaraduneytid",
            "type": "string",
          },
          "title": {
            "description": "Title of the institution",
            "example": "Dómsmálaráðuneytið",
            "type": "string",
          },
        },
        "required": [
          "id",
          "title",
          "slug",
          "nationalId",
        ],
        "type": "object",
      },
      "Paging": {
        "properties": {
          "hasNextPage": {
            "example": true,
            "type": "boolean",
          },
          "hasPreviousPage": {
            "example": false,
            "type": "boolean",
          },
          "nextPage": {
            "example": 2,
            "nullable": true,
            "type": "number",
          },
          "page": {
            "example": 1,
            "type": "number",
          },
          "pageSize": {
            "example": 10,
            "maximum": 100,
            "minimum": 1,
            "type": "number",
          },
          "previousPage": {
            "example": 1,
            "nullable": true,
            "type": "number",
          },
          "totalItems": {
            "example": 1000,
            "type": "number",
          },
          "totalPages": {
            "example": 10,
            "type": "number",
          },
        },
        "required": [
          "page",
          "totalPages",
          "totalItems",
          "nextPage",
          "previousPage",
          "pageSize",
          "hasNextPage",
          "hasPreviousPage",
        ],
        "type": "object",
      },
      "PostApplicationAttachmentBody": {
        "properties": {
          "fileExtension": {
            "type": "string",
          },
          "fileFormat": {
            "type": "string",
          },
          "fileLocation": {
            "type": "string",
          },
          "fileName": {
            "type": "string",
          },
          "fileSize": {
            "type": "number",
          },
          "originalFileName": {
