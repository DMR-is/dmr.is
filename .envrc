#!/bin/bash

# Local secrets come from 1Password via varlock, which exports them into this
# shell. Per-app `varlock run` then validates against apps/<app>/.env.schema,
# reading the values back out of process.env — the same shape deployed
# containers get, where ECS fills process.env instead. See
# config/1password/.env.schema for setup.
#
# Four deliberate details:
#
#   1. varlock is a devDependency, so it lives in node_modules/.bin and is NOT
#      on PATH. `has varlock` would be false for everyone and this would
#      silently never run.
#   2. The command substitution is captured and its status tested rather than
#      eval'd directly. `eval "$(cmd)"` does not abort under `set -e` and throws
#      the exit status away, so a 1Password auth failure would leave you in a
#      shell with no environment at all — surfacing much later as a confusing
#      crash inside a module that reads process.env at import time.
#   3. Exit status alone is NOT enough. varlock exits 0 while resolving every
#      variable to undefined — seen in practice when the 1Password plugin cached
#      an empty result, and again when a bulk load returned nothing without
#      erroring. Both leave a shell containing almost nothing and no warning, so
#      an implausibly small result is treated as failure too.
#   4. The fallback keeps anyone who has not set up 1Password working, and keeps
#      .envrc.git (which installs the submodule hooks) reachable either way.
#
# The threshold is a smoke test, not a contract: the 1Password environment holds
# dozens of variables, so a handful means something is wrong. Raising it to
# match the real count would break the moment someone adds or removes one.
VARLOCK_MIN_VARS=10

_varlock_count=0
if [ -x node_modules/.bin/varlock ]; then
  if _varlock_env="$(node_modules/.bin/varlock load --path config/1password --format shell --compact)"; then
    # `|| true` because grep exits non-zero on no match, which would abort
    # .envrc under direnv's `set -e` before the fallback could run.
    _varlock_count=$(printf '%s\n' "$_varlock_env" | grep -c '^export ' || true)
  fi
fi

if [ "${_varlock_count:-0}" -ge "$VARLOCK_MIN_VARS" ]; then
  eval "$_varlock_env"
else
  if [ -x node_modules/.bin/varlock ]; then
    echo "direnv: varlock returned ${_varlock_count} variables (expected >= ${VARLOCK_MIN_VARS})." >&2
    echo "direnv: falling back to .env.secret. To investigate:" >&2
    echo "direnv:   yarn varlock load --path config/1password --show-all --skip-cache" >&2
  fi
  source_env_if_exists .env.secret
fi
unset _varlock_env _varlock_count VARLOCK_MIN_VARS

# global

export NODE_OPTIONS="--max-old-space-size=8192"

# MacOS specific

export REDIS_CLUSTER_IP=0.0.0.0

# developer custom direnv config

source_env_if_exists .envrc.private
source_env_if_exists .envrc.git
