#!/bin/bash

# Environment loading is mid-migration. Read this before adding an export.
#
# TARGET STATE: no application configuration in this shell at all. Each app
# resolves its own environment at launch, from its own 1Password environment:
#
#   varlock run --path config/1password/<app> -- <command>
#
# This is not a style preference. Five API apps share the variable name DB_NAME
# with five different values, and a shell holds exactly one of them. Resolving
# per app is what makes per-app values possible, and it matches how deployed
# services already work, where ECS gives each container its own environment.
#
# CURRENT STATE: apps that have not been migrated yet still read this shell, so
# the file below is still sourced. An app is migrated once it has a directory
# under config/1password/.
#
# THE TRAP, and it is silent: process.env sits at the TOP of varlock's
# precedence chain, above anything a schema resolves. A variable still exported
# here therefore SHADOWS the value a migrated app resolves for itself. The app
# starts fine and uses the wrong value.
#
# So when you migrate an app, drop every variable whose value differs between
# apps -- DB_NAME, NEXTAUTH_URL, the IDS client ids. Variables that genuinely
# hold one value everywhere (AWS_*, IDENTITY_SERVER_DOMAIN) can stay until the
# last app is migrated, because shadowing them changes nothing.
#
# Consequence worth knowing: once a variable is no longer sourced here,
# `echo $DB_NAME` in this shell returns nothing, and ad-hoc commands
# (migrations, seeds, one-off scripts) need the same varlock run wrapper rather
# than inheriting from the shell.
#
# See config/1password/<app>/.env.schema for per-app setup, and the README
# section "Local environment setup".

source_env_if_exists .env.secret

# global

export NODE_OPTIONS="--max-old-space-size=8192"

# MacOS specific

export REDIS_CLUSTER_IP=0.0.0.0

# developer custom direnv config

source_env_if_exists .envrc.private
source_env_if_exists .envrc.git
