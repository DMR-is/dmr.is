#!/usr/bin/env bash
# Fake aws for run.sh. $SPEC has one line per service: "<service> <step>...",
# one step per describe-services poll, the last one repeating. A step is
# TAG:ROLLOUT:RUNNING/DESIRED:DEPLOYMENTS (ROLLOUT "-" omits rolloutState),
# MISSING, or ERR (the whole call fails). The first $TD_FAILURES
# describe-task-definition calls fail. Every call is logged to $STATE/calls.

set -uo pipefail
account=arn:aws:ecs:eu-west-1:111111111111
echo "$*" >> "$STATE/calls"

case "$2" in
  describe-services)
    services=()
    shift 2
    while [ $# -gt 0 ]; do
      if [ "$1" = --services ]; then
        shift
        while [ $# -gt 0 ] && [[ $1 != --* ]]; do services+=("$1") && shift; done
      else
        shift
      fi
    done
    if [ "${#services[@]}" -gt 10 ]; then
      echo "An error occurred (InvalidParameterException) when calling the DescribeServices operation: services can have at most 10 items." >&2
      exit 254
    fi

    out='{"services":[],"failures":[]}'
    for service in "${services[@]}"; do
      read -ra steps <<< "$(grep "^$service " "$SPEC" | cut -d' ' -f2-)"
      n=$(cat "$STATE/$service" 2> /dev/null || echo 0)
      echo $((n + 1)) > "$STATE/$service"
      [ "$n" -ge "${#steps[@]}" ] && n=$((${#steps[@]} - 1))
      step=${steps[$n]}

      case "$step" in
        ERR)
          echo "An error occurred (ExpiredTokenException) when calling the DescribeServices operation: The security token included in the request is expired" >&2
          exit 254
          ;;
        MISSING)
          out=$(jq --arg arn "$account:service/$service" '.failures += [{arn: $arn, reason: "MISSING"}]' <<< "$out")
          continue
          ;;
      esac

      IFS=: read -r tag rollout counts deployments <<< "$step"
      out=$(jq --arg service "$service" --arg td "$account:task-definition/$service-$tag:1" --arg rollout "$rollout" \
        --argjson running "${counts%/*}" --argjson desired "${counts#*/}" --argjson deployments "$deployments" '
        ({status: "PRIMARY", taskDefinition: $td, runningCount: $running, desiredCount: $desired}
          + (if $rollout == "-" then {} else {rolloutState: $rollout} end)
          + (if $rollout == "FAILED" then {rolloutStateReason: "ECS deployment circuit breaker: tasks failed to start."} else {} end)) as $primary
        | .services += [{serviceName: $service, status: "ACTIVE", desiredCount: $desired, taskDefinition: $td,
            deployments: ([$primary] + [range(1; $deployments) | {status: "ACTIVE", taskDefinition: "old", rolloutState: "COMPLETED"}])}]' <<< "$out")
    done
    echo "$out"
    ;;

  describe-task-definition)
    n=$(grep -c describe-task-definition "$STATE/calls")
    if [ "$n" -le "${TD_FAILURES:-0}" ]; then
      echo "An error occurred (AccessDeniedException) when calling the DescribeTaskDefinition operation" >&2
      exit 254
    fi
    while [ $# -gt 0 ]; do [ "$1" = --task-definition ] && td=$2; shift; done
    name=${td##*/}
    name=${name%:1}
    jq -n --arg td "$td" --arg image "111111111111.dkr.ecr.eu-west-1.amazonaws.com/${name%-v*}:${name##*-}" '
      {taskDefinition: {taskDefinitionArn: $td, containerDefinitions: [
        {name: "main", image: $image},
        {name: "datadog-agent", image: "public.ecr.aws/datadog/agent:latest"},
        {name: "log_router", image: "public.ecr.aws/aws-observability/aws-for-fluent-bit:stable"}]}}'
    ;;
esac
