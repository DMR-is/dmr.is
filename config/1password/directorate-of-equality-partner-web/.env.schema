# 1Password value resolution for directorate-of-equality-partner-web — LOCAL DEVELOPMENT ONLY.
#
# See config/1password/README.md for the model, the caching note, how to migrate
# an app, and why decorator names must not appear in prose in this file.

# @defaultRequired=infer
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=true)
# @setValuesBulk(opLoadEnvironment($OP_SHARED_ENVIRONMENT))
# @setValuesBulk(opLoadEnvironment($OP_APP_ENVIRONMENT))
# @import(../)
# @import(../../../apps/directorate-of-equality-partner-web/)
# ---

# OP_TOKEN is declared once in config/1password/.env.schema and reaches this file
# through the import above, so it is not redeclared here.

# The same shared environment every migrated app resolves from first: keys that are
# byte-identical across every deployed service, or absent from all of them and the
# same on every laptop. Keep it disjoint from the app environment below -- a key
# must live in exactly one of the two.
# @public @internal
OP_SHARED_ENVIRONMENT=xg6t32oousqpfj5lbmj4gpjxqe

# Everything this app needs, named as its ECS task definition names it. This app
# has no task definition yet -- its infrastructure is not built -- so for now the
# environment holds the names its own schema declares, and the task definition
# must be created to match rather than the other way round.
# @public @internal
OP_APP_ENVIRONMENT=javqqp5g3iithu6owaz5w74ojy
